      "has": [{ "type": "host", "value": "menhir-holdings.vercel.app" }],
      "destination": "https://menhir-holdings.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "menhir-holdings-menhir-tech.vercel.app" }],
      "destination": "https://menhir-holdings.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.menhir-holdings.com" }],
